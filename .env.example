# Deployment mode: uncomment exactly ONE line to choose how the service is
# exposed. With none uncommented, docker compose uses compose.yaml by default.
# COMPOSE_FILE=compose.yaml             # port-published (publishes PORT on the host)
# COMPOSE_FILE=compose.traefik.yaml     # behind a Traefik reverse proxy
# COMPOSE_FILE=compose.cloudflared.yaml # behind a Cloudflare Tunnel (no published port)

# The image the compose files run. IMAGE_TAG is rewritten by the server's
# deploy script - do not edit it by hand.
IMAGE_NAME=ghcr.io/cheminfo/ocl-cache
IMAGE_TAG=latest

# Port the API listens on, and the port published on the host in compose.yaml.
PORT=20822

# Where the SQLite database and the SDF / SMILES queues live, inside the
# container. The host directory is bind-mounted at ./data.
DATA_DIR=/app/data

# The audience-measurement snippet, taken verbatim and injected at the end of
# the served page's <head>. Unset means nothing is loaded, which is what a
# developer's checkout wants. Get this site's own data-website-id from the
# datami dashboard - the one below belongs to another site.
# TRACKING_SCRIPT=<script defer src="https://datami.cheminfo.org/script.js" data-website-id="00000000-0000-0000-0000-000000000000"></script>

# Where the site is served from, written into every canonical link, social card
# and sitemap entry. Unset, the request's own host is used, which is right for
# a single-host deployment.
# SITE_URL=https://ocl-cache.cheminfo.org

# How long the statistics service waits between two passes, in milliseconds.
# A pass normally reads only the molecules that arrived since the last one, so
# fifteen minutes costs almost nothing.
# STATS_INTERVAL=900000

# How long the three whole-table figures - the two distinct counts and the
# formula ranking - may stand before a pass walks the table to recompute them,
# in seconds. Daily by default. At two hundred million molecules that walk is
# around twenty minutes, so a very large cache may prefer weekly (604800).
# STATS_FULL_INTERVAL=86400

# The reverse proxies whose X-Forwarded-For is believed: an address, a CIDR
# range, a comma separated list of either, or a hop count. Leave unset when
# nothing proxies this service. `true` believes any peer and is only safe when
# the port is unreachable except through the proxy.
# TRUST_PROXY=192.168.1.5

# Cloudflare Tunnel token, only for COMPOSE_FILE=compose.cloudflared.yaml.
# TUNNEL_TOKEN=
