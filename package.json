{
  "name": "ocl-cache",
  "private": true,
  "version": "1.1.1",
  "license": "MIT",
  "description": "Cache molecule directed information in sqlite3",
  "author": "Luc Patiny",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "node --watch ./src/server.ts",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "processSDF": "node src/scripts/processSDF.ts | pino-pretty",
    "processSmiles": "node src/scripts/processSmiles.ts | pino-pretty",
    "start": "node ./src/server.ts",
    "test": "npm run test-only && npm run check-types && npm run eslint && npm run prettier",
    "test-only": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.0.0",
    "@sinclair/typebox": "^0.34.33",
    "bson": "^7.3.3",
    "fastify": "^5.12.5",
    "file-collection": "^6.7.0",
    "mass-tools": "^2.3.13",
    "openchemlib": "^9.25.0",
    "openchemlib-utils": "^8.18.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "piscina": "^5.3.2",
    "postgrator": "^8.0.0",
    "sdf-parser": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitest/coverage-istanbul": "^5.0.1",
    "@zakodium/tsconfig": "^1.0.5",
    "eslint": "^9",
    "eslint-config-zakodium": "^20.0.0",
    "mf-parser": "^3.9.3",
    "prettier": "^3.9.7",
    "typescript": "^6",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheminfo/ocl-cache.git"
  },
  "bugs": {
    "url": "https://github.com/cheminfo/ocl-cache/issues"
  },
  "homepage": "https://github.com/cheminfo/ocl-cache#readme",
  "volta": {
    "node": "24.6.0"
  }
}
